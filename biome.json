{
    "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
    "files": {
        "includes": ["**", "!**/dist"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4
    },
    "javascript": {
        "parser": {
            "unsafeParameterDecoratorsEnabled": true
        }
    },
    "linter": {
        "rules": {
            "style": {
                "useImportType": "off"
            }
        }
    }
}
